---
import '../assets/styles/style.scss'
---

<!doctype html>
<html lang="ru" class="dark-theme" data-theme-mode="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>EnoteSpace</title>
		<link
			rel="preload"
			href="/fonts/inter/InterVariable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/montserrat/Montserrat-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/montserrat/Montserrat-cyrillic.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
